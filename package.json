{
    "name": "ui",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc -b && vite build",
        "preview": "vite preview",
        "lint": "eslint . --ext .ts,.tsx,.vue --fix",
        "format": "prettier --write .",
        "check-types": "vue-tsc --noEmit",
        "check": "npm run check-types && npm run lint && npm run format "
    },
    "dependencies": {
        "@tailwindcss/vite": "^4.1.11",
        "gsap": "^3.13.0",
        "highlight.js": "^11.11.1",
        "tailwindcss": "^4.1.11",
        "vue": "^3.5.13"
    },
    "devDependencies": {
        "@eslint/css": "^0.9.0",
        "@eslint/js": "^9.30.1",
        "@eslint/json": "^0.12.0",
        "@types/node": "^24.2.0",
        "@vitejs/plugin-vue": "^5.2.3",
        "@vue/tsconfig": "^0.7.0",
        "eslint": "^9.30.1",
        "eslint-config-prettier": "^10.1.5",
        "eslint-plugin-vue": "^10.3.0",
        "globals": "^16.3.0",
        "prettier": "^3.6.2",
        "prettier-plugin-tailwindcss": "^0.6.13",
        "typescript": "~5.8.3",
        "typescript-eslint": "^8.35.1",
        "vite": "^6.3.5",
        "vue-tsc": "^2.2.8"
    }
}
